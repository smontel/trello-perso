# =============================================================
#  Variables d'environnement — modèle
#  Copier ce fichier en .env puis remplacer les valeurs :
#    cp .env.example .env        (PowerShell : Copy-Item .env.example .env)
#  Le fichier .env ne doit JAMAIS être commité.
# =============================================================

# ----- Base de données (lu par docker-compose) -----
# Mot de passe au choix : il est appliqué à la 1re création du volume.
# Pour le changer ensuite : docker compose down -v
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change-me

# ----- Backend (lu par Spring Boot) -----
# Doivent correspondre aux identifiants ci-dessus.
DB_URL=jdbc:postgresql://localhost:5432/taskmanager
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ----- Sécurité -----
# Clé de signature des JWT (Base64, 256 bits minimum).
# Générer avec : openssl rand -base64 32
JWT_SECRET=change-me